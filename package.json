{
  "name": "json-devtools-local",
  "version": "1.0.0",
  "description": "Formatador JSON e ferramentas para desenvolvedores, 100% local.",
  "desktopName": "json-devtools-local.desktop",
  "main": "electron/main.cjs",
  "author": "Lexipedia",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "dev": "concurrently -k \"ng serve --port 4200\" \"wait-on http://localhost:4200 && cross-env ELECTRON_DEV_URL=http://localhost:4200 electron .\"",
    "build": "ng build",
    "start:desktop": "npm run build && electron .",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:smoke": "npm run build && electron . --smoke-test",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && npm run dist:linux:appimage && npm run dist:linux:snap",
    "dist:linux:appimage": "electron-builder --linux AppImage --x64 --publish never",
    "dist:linux:snap": "electron-builder --linux snap --x64 --publish never",
    "release:ubuntu": "bash scripts/release-ubuntu.sh"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "20.3.27",
    "@angular/compiler": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/animations": "20.3.27",
    "@angular/forms": "20.3.27",
    "@angular/platform-browser": "20.3.27",
    "@angular/router": "20.3.27",
    "@noble/hashes": "^2.3.0",
    "@primeuix/themes": "1.2.5",
    "js-yaml": "5.2.3",
    "primeicons": "7.0.0",
    "primeng": "20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.34",
    "@angular/cli": "20.3.34",
    "@angular/compiler-cli": "20.3.27",
    "@types/js-yaml": "^4.0.9",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vitest": "3.2.7",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.lexipedia.jsondevtools",
    "productName": "JSON DevTools Local",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/json-devtools-local/browser/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "snap"
      ],
      "category": "Development",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "synopsis": "JSON e DevTools locais",
      "description": "Formate, valide e converta JSON, gere UUIDs, Base64 e hashes sem enviar dados para a internet."
    },
    "snapcraft": {
      "base": "core22",
      "core22": {
        "grade": "stable",
        "confinement": "strict",
        "summary": "JSON e DevTools locais",
        "useTemplateApp": true
      }
    }
  }
}
